# Chave pessoal da OpenXBL (https://xbl.io > entre com a conta Microsoft > API Keys)
OPENXBL_KEY=

# Opcionais
# POLL_SECONDS=90          # intervalo entre consultas (mín. 30; plano grátis: ~150 req/hora)
# GAME_SUFFIX=" (Xbox)"    # texto depois do nome do jogo (máx. 40 caracteres)
# DEVICE_TYPES=XboxOne,Scarlett,XboxSeries,Xbox360   # vazio = qualquer dispositivo (PC, celular...)
# IGNORE_TITLES=Netflix,YouTube                       # títulos extras que não são jogos
