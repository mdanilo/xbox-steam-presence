{
  "name": "xbox-steam-presence",
  "version": "1.0.0",
  "private": true,
  "description": "Espelha o jogo que você está jogando no Xbox (console ou Cloud) como jogo não-Steam no seu status da Steam.",
  "type": "module",
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check": "node dist/src/index.js --check",
    "login": "node dist/src/login.js"
  },
  "dependencies": {
    "steam-user": "5.3.0"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "protobufjs": "7.6.6"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/steam-user": "5.1.1",
    "typescript": "7.0.2"
  },
  "license": "MIT"
}
